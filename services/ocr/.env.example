# AWS credentials for the Textract fallback (used only when PaddleOCR finds no plate).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Number of uvicorn workers. Each worker loads its own PaddleOCR model (~hundreds of MB),
# so size this to the container's memory limit. Default 1.
WEB_CONCURRENCY=1
