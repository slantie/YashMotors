DATABASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
ARCHIVE_PASSWORD=
# HMAC signing key for session cookies. MUST differ from ARCHIVE_PASSWORD and be >=32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ARCHIVE_JWT_SECRET=
NODE_ENV=production
# Observability (optional; no-op when unset). NEXT_PUBLIC_ is exposed to the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI to upload source maps:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
