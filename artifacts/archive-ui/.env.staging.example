# Archive UI — STAGING. Copy to .env.staging (git-ignored) and fill.

# ⚠️ MUST be the same Neon BRANCH used by the backend staging stack — NEVER prod main.
DATABASE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# Staging login password (set anything — it's isolated from prod).
ARCHIVE_PASSWORD=
# HMAC signing key, MUST differ from ARCHIVE_PASSWORD and be >=32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ARCHIVE_JWT_SECRET=

NODE_ENV=production

# Observability (optional).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
