PORT=8080
NODE_ENV=production
ADMIN_NUMBER_1=
ADMIN_NUMBER_2=
# Required (fail-closed in production). Must match the backend's WHATSAPP_INTERNAL_SECRET.
# docker-compose maps WHATSAPP_INTERNAL_SECRET -> INTERNAL_SECRET for this service.
WHATSAPP_INTERNAL_SECRET=
# Observability (optional; no-op when unset)
SENTRY_DSN=
LOG_LEVEL=info
