# WhatsApp api-server — STAGING. Copy to .env.staging (git-ignored) and fill.
PORT=8080
NODE_ENV=production

# Admin numbers the service may message (staging — use test numbers if exercising WA).
ADMIN_NUMBER_1=
ADMIN_NUMBER_2=

# Must match the backend staging WHATSAPP_INTERNAL_SECRET (fail-closed in production).
WHATSAPP_INTERNAL_SECRET=

# Observability (optional; no-op when unset).
SENTRY_DSN=
LOG_LEVEL=info
