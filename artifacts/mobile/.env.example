# Copy this to .env.local
# Set to your laptop's local IP (find it with: ipconfig on Windows)
# Both laptop and phone must be on the same WiFi network
EXPO_PUBLIC_API_URL=http://192.168.29.136:3001

# Admin/staff contact numbers (also set per-profile in eas.json for builds)
EXPO_PUBLIC_ADMIN_PHONE=
EXPO_PUBLIC_ADMIN_DISPLAY=
EXPO_PUBLIC_NANDISH_PHONE=
EXPO_PUBLIC_NANDISH_DISPLAY=

# Crash reporting (optional; no-op when unset). Set per-profile in eas.json for builds.
EXPO_PUBLIC_SENTRY_DSN=
