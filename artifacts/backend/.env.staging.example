# Backend — STAGING. Copy to .env.staging (git-ignored) and fill.
PORT=3001
NODE_ENV=production

# Reuse prod JWT_SECRET or use a distinct staging one (distinct = staging tokens never
# valid against prod, cleaner isolation).
JWT_SECRET=

# Must match api-server staging WHATSAPP_INTERNAL_SECRET (compose maps it to INTERNAL_SECRET).
WHATSAPP_INTERNAL_SECRET=

# ⚠️ MUST be a Neon BRANCH connection string — NEVER the prod main branch.
DATABASE_URL=

# S3 — use a staging bucket if you have one, else prod bucket is tolerable for read tests.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-south-1

# Redis is the in-stack service (compose network name).
REDIS_HOST=redis
REDIS_PORT=6379

# CORS: add the archive staging origin if it calls the backend cross-origin.
CORS_ORIGINS=

# Observability (optional). A separate Sentry "staging" project keeps noise out of prod.
SENTRY_DSN=
LOG_LEVEL=info
