PORT=3001
NODE_ENV=development

# JWT (min 32 chars recommended)
JWT_SECRET=change_me_to_a_random_32plus_char_string

# Internal service auth
WHATSAPP_INTERNAL_SECRET=change_me_to_another_random_secret

# NeonDB (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-south-1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS: comma-separated browser origins. Empty = locked down (native app unaffected).
CORS_ORIGINS=

# Observability (optional; Sentry is a no-op when DSN unset)
SENTRY_DSN=
LOG_LEVEL=info
